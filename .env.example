# Copy this file to .env.local and fill in real values.
# Every variable here maps to a "configurable business variable" called out in
# the project spec. Nothing in the codebase invents a value for these — until
# they're set, the relevant feature runs in its safe/mocked default state.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.shuddhodhan.com

# ---- Contact ----
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=       # E.164 without +, e.g. 919999999999. WhatsApp button hides itself until set.
NEXT_PUBLIC_BUSINESS_HOURS=        # e.g. "Mon-Sat, 10am-6pm IST". Free text, shown on /contact.

# ---- Social ----
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ---- Legal entity / statutory details (footer + legal pages) ----
NEXT_PUBLIC_LEGAL_ENTITY_NAME=     # e.g. "Bharat Jyoti" or the registered company name — not invented, must be supplied.
NEXT_PUBLIC_REGISTERED_ADDRESS=    # Full registered/business address for legal + grievance pages.
NEXT_PUBLIC_FSSAI_LICENSE_NUMBER=
NEXT_PUBLIC_GSTIN=                 # Leave blank if not GST-registered.

# ---- Grievance Officer (Consumer Protection (E-Commerce) Rules, 2020) ----
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_DESIGNATION=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER_ADDRESS=

# ---- Meta Ads / Pixel ----
NEXT_PUBLIC_META_PIXEL_ID=         # Pixel script no-ops until set.
META_CAPI_ACCESS_TOKEN=            # Server-side Conversions API (lib/analytics/meta-capi.ts) — sends a deduped Purchase event alongside the browser Pixel. No-ops until both this and NEXT_PUBLIC_META_PIXEL_ID are set.

# ---- GA4 ----
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---- Payment gateway (Razorpay) — NO COD is supported anywhere ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Payment processing fee (leave disabled unless a real fee applies) ----
PAYMENT_FEE_ENABLED=false
PAYMENT_FEE_PERCENTAGE=0
PAYMENT_FEE_FIXED_PAISE=0
PAYMENT_FEE_TAX_PERCENTAGE=0

# ---- Shipping: origin + Indore local delivery ----
SHIPPING_ORIGIN_PINCODE=452001
INDORE_DELIVERY_ENABLED=true
INDORE_FREE_SHIPPING=false
INDORE_FLAT_RATE=49
INDORE_MINIMUM_FREE_SHIPPING_VALUE=999
INDORE_SERVICEABLE_PINCODES=       # Comma-separated, e.g. 452001,452003,452010. Empty = not yet configured (no Indore pincode will be treated as serviceable).

# ---- Shipping: national / outside Indore ----
SHIPPING_PROVIDER=mock             # "mock" uses lib/shipping/mock-national-provider.ts (placeholder rates). Replace with a real provider name once integrated.

# ---- Order database (Supabase) ----
# A Supabase project already exists for this account (see the Supabase
# dashboard). The URL is not secret; the service_role key IS secret — copy it
# from Project Settings > API and never expose it with a NEXT_PUBLIC_ prefix.
# Without both set, orders fall back to an in-memory store (dev-only, resets
# on restart) — see lib/orders/store.ts.
NEXT_PUBLIC_SUPABASE_URL=https://umydmimbteiyiuohpdio.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Tax ----
GST_PERCENTAGE=0
